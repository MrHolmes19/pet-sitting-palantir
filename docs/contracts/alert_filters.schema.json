{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet-sitting-palantir.local/contracts/alert_filters.schema.json",
  "title": "alert_filters",
  "type": "object",
  "description": "Personal notification rule. Matching listings can trigger notifications; Telegram is the first channel, but the filter itself is channel-agnostic.",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "description": "Internal database id."
    },
    "name": {
      "type": "string",
      "description": "Human-readable filter name."
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether this filter should be evaluated."
    },
    "site_filter": {
      "description": "Site-level filters describing the search area this alert covers.",
      "$ref": "site_filter.schema.json"
    },
    "local_filter": {
      "description": "Local notification matching rules evaluated by application code.",
      "$ref": "local_filter.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp."
    }
  },
  "required": [
    "id",
    "name",
    "enabled",
    "site_filter",
    "local_filter",
    "created_at",
    "updated_at"
  ],
  "examples": [
    {
      "id": 10,
      "name": "Auckland Central good sits",
      "enabled": true,
      "site_filter": {
        "state": "north-island",
        "region": "auckland",
        "subregion": [
          "auckland-central"
        ]
      },
      "local_filter": {
        "min_duration_days": 7,
        "max_duration_days": 45,
        "allowed_regions": [
          "Auckland"
        ],
        "allowed_subregions": [
          "Auckland - Central",
          "North Shore City"
        ],
        "max_total_animals": 3,
        "max_dogs": 2,
        "cats_allowed": true,
        "farm_animals_allowed": false,
        "horses_allowed": false,
        "min_reply_rating_score": 5,
        "allowed_house_types": [
          "House",
          "Unit",
          "Flat"
        ],
        "excluded_house_types": [
          "Farm House"
        ],
        "exclude_keywords": [
          "farm",
          "rural",
          "own transport required"
        ]
      },
      "created_at": "2026-05-03T09:00:00Z",
      "updated_at": "2026-05-03T09:00:00Z"
    }
  ]
}
