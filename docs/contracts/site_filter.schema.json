{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet-sitting-palantir.local/contracts/site_filter.schema.json",
  "title": "site_filter",
  "type": "object",
  "description": "KiwiHouseSitters search filters used to build or describe a site search scope.",
  "additionalProperties": true,
  "properties": {
    "state": {
      "type": "string",
      "description": "KiwiHouseSitters state filter, such as north-island or south-island."
    },
    "region": {
      "type": "string",
      "description": "KiwiHouseSitters region filter."
    },
    "subregion": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "KiwiHouseSitters subregion filter. Can be one value or multiple values."
    }
  },
  "examples": [
    {
      "state": "north-island",
      "region": "auckland",
      "subregion": [
        "auckland-central"
      ]
    }
  ]
}
